VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public address of this deployment, e.g. https://ledger.example.com. Used for the canonical link,
# og:url, sitemap.xml and robots.txt at build time. Leave unset and the build ships none of them.
# VITE_SITE_URL=

# Local Supabase stack (pnpm db:start). Get the anon key from `pnpm db:status`.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<anon key from pnpm db:status>
